# ==========================================
# VERCEL ENV VARS — set tại vercel.com/.../settings/environment-variables
# ==========================================

# Supabase project (cùng URL với .env của Python local app)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_BUCKET=photobooth

# Branding (tùy chọn)
NEXT_PUBLIC_EVENT_NAME=Sinh Nhật Vui Vẻ
NEXT_PUBLIC_EVENT_HASHTAG=#happybirthday
