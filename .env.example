# ==========================================
# PHOTOBOOTH CONFIG — copy này thành .env và điền vào
# ==========================================

# Camera mode: "dslr" (gphoto2) hoặc "webcam" (test trước khi cắm máy ảnh)
CAMERA_MODE=webcam

# ==========================================
# QR CODE — chế độ LOCAL (không cần internet)
# ==========================================
# IP nội bộ tự detect → khách kết nối WiFi sự kiện và quét QR
# KHÔNG CẦN sửa, app tự dò
PUBLIC_URL=

# Optional: nếu venue có internet ổn định và muốn QR còn dùng được sau sự kiện
# Tạo bucket public "photobooth" tại supabase.com → Settings → API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJxxxxx...
# SUPABASE_BUCKET=photobooth

# ==========================================
# CANON PRINTER
# Chạy `lpstat -p` trong Terminal để xem tên printer
# Tên thường có dạng: Canon_SELPHY_CP1500, Canon_PIXMA_TS5350...
# ==========================================
PRINTER_NAME=
PRINT_ENABLED=false

# ==========================================
# EVENT
# ==========================================
EVENT_NAME=Sinh Nhật Vui Vẻ
EVENT_HASHTAG=#happybirthday
