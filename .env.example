# ==========================================
# PHOTOBOOTH CONFIG — copy này thành .env và điền vào
# ==========================================

# Camera mode: "dslr" (gphoto2) hoặc "webcam" (test trước khi cắm máy ảnh)
CAMERA_MODE=webcam

# ==========================================
# QR CODE
# ==========================================
# QR target priority:
#   1. GALLERY_URL (Vercel) ← phương án B, recommend
#   2. Supabase public URL (direct .jpg)
#   3. Local IP fallback
# ==========================================

# 🌐 Vercel gallery URL (sau khi deploy web/ lên Vercel)
# Ví dụ: https://photoboth-chibi.vercel.app
GALLERY_URL=

# ☁️ Supabase Storage (cho phép Vercel page fetch ảnh)
# 1. Tạo project free tại https://supabase.com
# 2. Settings → API → copy URL + anon key
# 3. Storage → New bucket → tên "photobooth" → Public ✓
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=photobooth

# 🏠 Local fallback (nếu không config Vercel/Supabase)
# Để trống thì app tự dò IP nội bộ
PUBLIC_URL=

# ==========================================
# CANON PRINTER
# Chạy `lpstat -p` trong Terminal để xem tên printer
# Tên thường có dạng: Canon_SELPHY_CP1500, Canon_PIXMA_TS5350...
# ==========================================
PRINTER_NAME=
PRINT_ENABLED=false

# ==========================================
# EVENT
# ==========================================
EVENT_NAME=Sinh Nhật Vui Vẻ
EVENT_HASHTAG=#happybirthday
